# Copy to .env and fill in. NEVER commit the real .env.
# Keys come from aistudio.google.com (use the temp hackathon account, not the free-tier OAuth one).

# Simplest: one key, used by every agent.
GEMINI_API_KEY=

# Or one dedicated key per agent (each role's traffic stays on its own key):
GEMINI_API_KEY_ORCHESTRATOR=
GEMINI_API_KEY_CODER=
GEMINI_API_KEY_CRITIC=

# Or a comma-separated pool: 1st = orchestrator, 2nd = coder, 3rd = critic, the rest are spares that a role
# fails over to when its key hits a rate limit (only at a fresh interaction, never mid-chain).
# Rate limits are per Google PROJECT, so keys from one project share a quota; failover only adds capacity
# when the keys come from different projects.
GEMINI_API_KEYS=
